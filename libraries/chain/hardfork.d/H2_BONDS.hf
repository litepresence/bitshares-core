// H2 bonds: bonded price oracles + vault-backed issuance primitives.
// Placeholder activation flag only -- gates nothing yet. The real date is set
// by the committee when the feature is scheduled for a particular network.
// Before it passes, everything gated behind it stays rejected, so no node can
// produce a block a pre-fork node cannot validate.
#ifndef HARDFORK_H2_BONDS_TIME
#define HARDFORK_H2_BONDS_TIME (fc::time_point_sec( 1893456000 )) // 2030-01-01T00:00:00Z
#define HARDFORK_H2_BONDS_PASSED(now) (now >= HARDFORK_H2_BONDS_TIME)
#endif
